<?xml version="1.0"?>
<ruleset name="ACF On The Go">
	<description>WordPress Coding Standards ruleset for the ACF On The Go plugin.</description>

	<!-- Only scan PHP files. -->
	<arg name="extensions" value="php"/>

	<!-- Show sniff codes and progress in reports. -->
	<arg value="ps"/>

	<!-- Strip the filepaths down to the relevant bit. -->
	<arg name="basepath" value="./"/>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/.wordpress-org/*</exclude-pattern>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- Verify that everything is properly text-domained for translation. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="acf-on-the-go"/>
			</property>
		</properties>
	</rule>

	<!-- Enforce the plugin's unique prefixes for globals, hooks, and asset handles. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="acfg"/>
				<element value="ACFG"/>
			</property>
		</properties>
	</rule>

	<!-- Main plugin bootstrap file must keep the plugin slug name, not a class- prefix. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/acf-on-the-go\.php</exclude-pattern>
	</rule>

	<config name="minimum_supported_wp_version" value="4.8"/>
	<config name="testVersion" value="5.6-"/>
</ruleset>
