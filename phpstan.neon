includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - acf-on-the-go.php
        - uninstall.php
        - includes
    excludePaths:
        - vendor/*
        - tests/*
    bootstrapFiles:
        - vendor/szepeviktor/phpstan-wordpress/bootstrap.php
        - phpstan-bootstrap.php

    # get_field()/update_field() are provided at runtime by the ACF (or Secure
    # Custom Fields) plugin, an optional soft dependency checked via
    # class_exists( 'ACF' ) rather than a composer requirement, so no stubs
    # are available for static analysis to resolve them against.
    ignoreErrors:
        - '#Function get_field not found\.#'
        - '#Function update_field not found\.#'
