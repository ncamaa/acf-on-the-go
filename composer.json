{
    "name": "ncamaa/acf-on-the-go",
    "description": "Edit ACF text fields from the front end of your website",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://wordpress.org/plugins/acf-on-the-go/",
    "authors": [
        {
            "name": "Nadav Cohen",
            "homepage": "https://www.linkedin.com/in/nadav-cohen-wd/"
        },
        {
            "name": "Alkesh Miyani",
            "homepage": "https://miyanialkesh7.com"
        }
    ],
    "require": {
        "php": ">=5.6"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 5.6- --extensions=php --ignore=vendor,tests ."
    }
}
